{
  "name": "luvomobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "icons": "npx @svgr/cli ./src/assets/icons --out-dir ./src/components/SvgIcon/icons --native --typescript --icon",
    "reset:all": "rm -rf node_modules ios android && yarn install && expo prebuild --clean",
    "start": "expo start --dev-client",
    "test": "jest",
    "ai:review": "tsx ai/runner/run-agent.ts review",
    "ai:test": "tsx ai/runner/run-agent.ts test",
    "ai:upgrade": "tsx ai/runner/run-agent.ts upgrade",
    "prebuild": "expo prebuild --clean"
  },
