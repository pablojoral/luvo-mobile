    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.25",
    "@rnmapbox/maps": "^10.2.6",
    "@tanstack/react-query": "^5.89.0",
    "axios": "^1.11.0",
    "babel-preset-expo": "~56.0.0",
